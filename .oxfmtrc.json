{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "ignorePatterns": [
    "vendor/",
    // Generated by typeshare (`pnpm generate`), and CI checks that it's up to date.
    "js/protocol.generated.ts",
    // A cargo-about template
    "about.hbs",
    // Formatted by hand: oxfmt splits up flag pairs (`"-C", "..."`) and feature lists.
    "**/*.toml"
  ]
}
