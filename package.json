{
  "name": "blunt-image-optimization",
  "version": "0.1.0",
  "description": "A safer image optimization library for Node.js, built on memory-safe Rust decoders",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "binding.js",
    "binding.d.ts",
    "blunt-image-optimization.wasi.cjs",
    "wasi-worker.mjs"
  ],
  "napi": {
    "binaryName": "blunt-image-optimization",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">= 20.9.0"
  },
  "scripts": {
    "build": "pnpm build:native --release && pnpm build:js",
    "build:debug": "pnpm build:native && pnpm build:js",
    "build:native": "napi build --platform --no-const-enum --js binding.js --dts binding.d.ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:js": "tsc -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "test:wasi": "NAPI_RS_FORCE_WASI=error node --run test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && pnpm typecheck",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.6",
    "@emnapi/runtime": "2.0.0-alpha.6",
    "@napi-rs/cli": "^3.10.8",
    "@napi-rs/wasm-runtime": "^1.2.5",
    "@tybys/wasm-util": "^0.10.4",
    "@types/node": "^26.6.5",
    "emnapi": "2.0.0-alpha.6",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
