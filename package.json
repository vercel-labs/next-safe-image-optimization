{
  "name": "nsio-workspace",
  "private": true,
  "scripts": {
    "build": "turbo run nsio-worker#build @next/safe-image-optimization#build",
    "build:release": "turbo run nsio-worker#build:release @next/safe-image-optimization#build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:release": "node scripts/build-wasm.mjs --release",
    "test": "turbo run test",
    "test:wasm": "turbo run test:wasm",
    "typecheck": "turbo run typecheck",
    "quality": "turbo run quality",
    "quality:fix": "turbo run quality:fix",
    "lint": "turbo run lint",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "format:js": "oxfmt --check",
    "format:js:fix": "oxfmt",
    "generate": "typeshare crates/core --lang=typescript --output-file=packages/nsio/protocol.generated.ts",
    "set-version": "node scripts/set-version.mjs"
  },
  "devDependencies": {
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.11.10"
  },
  "packageManager": "pnpm@12.11.2"
}
