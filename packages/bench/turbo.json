{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // Typechecks against `packages/nsio/dist/*.d.ts`, so it needs the JS package's build.
    "typecheck": {
      "dependsOn": ["^build"]
    },
    // Like the JS package's: there are no `lint` or `quality` scripts here, so these only run their
    // dependencies, including oxlint and oxfmt (`//#lint:js` and `//#format:js`), which check the
    // whole repo.
    "lint": {
      "dependsOn": ["//#lint:js"]
    },
    "quality": {
      "dependsOn": ["lint", "typecheck", "//#format:js"]
    },
    "quality:fix": {
      "dependsOn": ["//#format:js:fix"]
    },
    // The benchmark itself, with the worker it measures (package.json's scripts set
    // `NEXT_SAFE_IMAGE_OPTIMIZATION_WORKER_PATH` to it). Never cached: it's a measurement.
    "bench": {
      "dependsOn": ["^build", "nsio-worker#build"],
      "cache": false
    },
    "bench:release": {
      "dependsOn": ["^build", "nsio-worker#build:release"],
      "cache": false
    }
  }
}
