{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": true,
    "stripInternal": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  // Only the top level: `test/` has its own tsconfig.json.
  "include": ["*.ts"]
}
