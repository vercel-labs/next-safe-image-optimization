{
  "$schema": "https://turborepo.com/schema.json",
  // cargo and napi read many environment variables (CARGO_*, CC_*, ...).
  "envMode": "loose",
  "tasks": {
    // Cargo has its own incremental cache, which also knows about inputs turbo can't see (the
    // toolchain, the target, RUSTFLAGS, ...).
    "build:native": {
      "cache": false
    },
    "build:native:release": {
      "cache": false
    },
    "build:wasm": {
      "cache": false
    },
    "build:wasm:release": {
      "cache": false
    },
    // Compiles against the committed `binding.d.ts` (like CI's test jobs), so it runs alongside the
    // native build.
    "build:js": {
      "inputs": ["js/**", "tsconfig.json", "binding.d.ts"],
      "outputs": ["dist/**"]
    }
  }
}
