{
  "$schema": "https://turborepo.com/schema.json",
  // Tasks only see the variables listed here, and turbo's defaults (PATH, HOME, TMP, GITHUB_*, ...).
  // Anything else (like a RUSTFLAGS in someone's shell) is ignored, so builds are reproducible.
  "envMode": "strict",
  // Where cargo and rustup are installed, if not in the default location. CI sets CARGO_TERM_COLOR.
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "CARGO_TERM_COLOR"],
  "futureFlags": {
    // Each crate is a package, and the workspace is `nsio-cargo` (`[workspace.metadata]` in
    // Cargo.toml), with built-in `build`, `test`, `check`, `lint`, and `format` tasks. Even tasks
    // that don't use Rust need cargo, because turbo runs `cargo metadata` first.
    "experimentalCargoWorkspaces": true,
    // For `command`.
    "experimentalTaskCommand": true
  },
  // Packages' own tasks are in their turbo.json (packages/nsio and crates/worker). These are the root
  // package's (`//`), and the Cargo workspace's (`nsio-cargo`), which is also at the root, so it
  // can't have its own.
  "tasks": {
    // The built-in commands use `--workspace`, which includes vendor/avif-decode. These only include
    // the default members (crates/*).
    "nsio-cargo#lint": {
      "command": ["cargo", "clippy", "--all-targets", "--locked", "--", "-D", "warnings"]
    },
    "nsio-cargo#test": {
      "command": ["cargo", "test", "--locked"],
      // The worker's tests check its version against the JS package's.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/nsio/package.json"]
    },
    // `turbo quality` runs every package's lints, formatting checks, and typechecks.
    "nsio-cargo#quality": {
      "dependsOn": ["nsio-cargo#lint", "nsio-cargo#format:check"]
    },
    "nsio-cargo#format:check": {
      "command": ["cargo", "fmt", "--all", "--check"]
    },
    // `turbo quality:fix` runs every package's fixes. These write files, so they aren't cached, and
    // rustfmt formats after clippy's fixes, so that they don't write the same files at once. Clippy
    // only fixes a dirty (or staged) worktree with `--allow-dirty` (and `--allow-staged`).
    "nsio-cargo#quality:fix": {
      "dependsOn": ["nsio-cargo#format:fix"]
    },
    "nsio-cargo#lint:fix": {
      "command": [
        "cargo",
        "clippy",
        "--fix",
        "--allow-dirty",
        "--allow-staged",
        "--all-targets",
        "--locked"
      ],
      "cache": false
    },
    "nsio-cargo#format:fix": {
      "command": ["cargo", "fmt", "--all"],
      "dependsOn": ["nsio-cargo#lint:fix"],
      "cache": false
    },

    // Root package.json scripts: oxlint and oxfmt, for the whole repo (oxfmt formats Markdown, YAML, and JSON too). The fixes
    // write files, so they aren't cached, and oxfmt formats after oxlint's fixes, so that they don't
    // write the same files at once.
    "//#lint:js": {},
    "//#lint:js:fix": {
      "cache": false
    },
    "//#format:js": {},
    "//#format:js:fix": {
      "dependsOn": ["//#lint:js:fix"],
      "cache": false
    }
  }
}
